[Unit]
Description=ferret: download DB-IP Lite City + ASN databases (CC BY 4.0, https://db-ip.com)
Documentation=https://db-ip.com/db/lite.php
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ferret
Group=ferret
Environment="FERRET_CONTACT=ferret-geo (a@example.com)"
StateDirectory=ferret
StateDirectoryMode=0755
UMask=0022
ExecStart=/usr/local/bin/ferret-geo --dir /var/lib/ferret --changed-marker /var/lib/ferret/.geo-changed
ExecStartPost=+/bin/sh -c 'if [ -e /var/lib/ferret/.geo-changed ]; then rm -f /var/lib/ferret/.geo-changed; /usr/sbin/nginx -t -q && /usr/sbin/nginx -s reload; fi'
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle

ProtectSystem=strict
ReadWritePaths=/var/lib/ferret
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
