# Address parsing

_inet_pton = socket.inet_pton
_AF4 = socket.AF_INET
_AF6 = socket.AF_INET6
_from_bytes = int.from_bytes


def parse_ip_range(s):
    """Parse an IP, CIDR or 'a-b' range. Returns (family, start, end) or None."""
    s = s.strip()
    if not s or len(s) > 100:
        return None
    if "-" in s and "/" not in s:
        a, _, b = s.partition("-")
        ra, rb = parse_ip_range(a), parse_ip_range(b)
        if ra and rb and ra[0] == rb[0] and ra[1] <= rb[2]:
            return (ra[0], ra[1], rb[2])
        return None
    addr, slash, plen = s.partition("/")
    if addr.startswith("["):
        # "[v6]" or "[v6]:port"
        close = addr.find("]")
        if close < 0:
            return None
        addr = addr[1:close]
    if ":" in addr:
        fam, bits, af = 6, 128, _AF6
        if "%" in addr:
            return None
    elif "." in addr:
        fam, bits, af = 4, 32, _AF4
    else:
        return None
    try:
        v = _from_bytes(_inet_pton(af, addr), "big")
    except OSError:
        return None
    if slash:
        if not plen.isdigit():
            return None
        p = int(plen)
        if p > bits:
            return None
    else:
        p = bits
    host = (1 << (bits - p)) - 1
    start = v & ~host & ((1 << bits) - 1)
    return (fam, start, start | host)


def _maybe_ip(s):
    return ("." in s or ":" in s) and len(s) <= 100 and s[:1] in "0123456789abcdefABCDEF[:"


def _decode(data):
    if data[:3] == b"\xef\xbb\xbf":
        data = data[3:]
    return data.decode("utf-8", errors="replace")


def _json_load(text):
    """json.loads that tolerates trailing data (e.g. PIA's appended signature)."""
    return json.JSONDecoder().raw_decode(text.lstrip())[0]


def _walk_ips(obj, tagmask, keys=None):
    """All IP/CIDR strings anywhere in obj; with keys, only values (or lists of
    values) stored under one of those dict keys."""
    out = []
    stack = [(obj, keys is None)]
    while stack:
        o, take = stack.pop()
        if isinstance(o, dict):
            for k, v in o.items():
                stack.append((v, keys is None or k in keys))
        elif isinstance(o, list):
            stack.extend((v, take) for v in o)
        elif take and isinstance(o, str) and _maybe_ip(o):
            r = parse_ip_range(o)
            if r:
                out.append((r[0], r[1], r[2], tagmask, 0))
    return out


def parse_json_walk(data, tagmask):
    return {"ranges": _walk_ips(_json_load(_decode(data)), tagmask), "asns": {}}


def parse_json_keys(data, tagmask, arg):
    keys = set(arg.split(","))
    return {"ranges": _walk_ips(_json_load(_decode(data)), tagmask, keys), "asns": {}}


_CODE_RE = re.compile(r"<(?:code|pre)\b[^>]*>(.*?)</(?:code|pre)>", re.S | re.I)
_TAG_RE = re.compile(r"<[^>]*>")


def parse_html_json(data, tagmask):
    """JSON documents shown in <pre>/<code> blocks of an HTML page (Amazonbot).
    Only those blocks are read: the rest of such pages may echo the client IP."""
    out = []
    for block in _CODE_RE.findall(_decode(data)):
        text = html.unescape(_TAG_RE.sub("", block)).strip()
        if not text.startswith(("{", "[")):
            continue
        try:
            obj = _json_load(text)
        except ValueError:
            continue
        out.extend(_walk_ips(obj, tagmask))
    return {"ranges": out, "asns": {}}


def _lines(data):
    for line in _decode(data).splitlines():
        line = line.strip()
        if not line or line[0] in "#;":
            continue
        for sep in ("#", ";"):
            i = line.find(sep)
            if i >= 0:
                line = line[:i]
        tok = line.replace(",", " ").replace("\t", " ").split()
        if tok:
            yield tok


def parse_text(data, tagmask):
    out = []
    for tok in _lines(data):
        r = parse_ip_range(tok[0])
        if r:
            out.append((r[0], r[1], r[2], tagmask, 0))
    return {"ranges": out, "asns": {}}


def parse_range2(data, tagmask):
    """'start end ...' columns (DShield block.txt); a single address is a host."""
    out = []
    for tok in _lines(data):
        a = parse_ip_range(tok[0])
        if not a:
            continue
        b = parse_ip_range(tok[1]) if len(tok) > 1 else None
        if b and b[0] == a[0] and b[2] >= a[1]:
            a = (a[0], a[1], b[2])
        out.append((a[0], a[1], a[2], tagmask, 0))
    return {"ranges": out, "asns": {}}


def parse_hostport(data, tagmask):
    """Proxy lists: '[scheme://][user:pass@]host:port' -- host must be a literal IP."""
    out = []
    for tok in _lines(data):
        s = tok[0]
        i = s.find("://")
        if i >= 0:
            s = s[i + 3:]
        s = s.rsplit("@", 1)[-1].split("/", 1)[0]
        if not s.startswith("[") and s.count(":") == 1:
            s = s.partition(":")[0]          # v4:port (bare v6 has >= 2 colons)
        r = parse_ip_range(s)
        if r:
            out.append((r[0], r[1], r[2], tagmask, 0))
    return {"ranges": out, "asns": {}}


def _ndjson(data):
    for line in _decode(data).splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            yield json.loads(line)
        except ValueError:
            continue


def parse_ndjson_cidr(data, tagmask):
    out = []
    for o in _ndjson(data):
        c = o.get("cidr")
        if isinstance(c, str):
            r = parse_ip_range(c)
            if r:
                out.append((r[0], r[1], r[2], tagmask, 0))
    return {"ranges": out, "asns": {}}


def _parse_asn(v):
    if isinstance(v, int):
        a = v
    else:
        v = str(v).strip().upper()
        if v.startswith("AS"):
            v = v[2:]
        if not v.isdigit():
            return None
        a = int(v)
    return a if 0 < a <= 0xFFFFFFFF else None


def parse_ndjson_asn(data, tagmask):
    asns = {}
    for o in _ndjson(data):
        a = _parse_asn(o.get("asn", ""))
        if a:
            asns[a] = asns.get(a, 0) | tagmask
    return {"ranges": [], "asns": asns}


def parse_ipsum(data, tagmask):
    out = []
    for line in _decode(data).splitlines():
        if not line or line[0] == "#":
            continue
        parts = line.split()
        if len(parts) < 2 or not parts[1].isdigit():
            continue
        r = parse_ip_range(parts[0])
        if r:
            out.append((r[0], r[1], r[2], 0, min(int(parts[1]), 255)))
    return {"ranges": out, "asns": {}}


def parse_badasn(data, tagmask):
    asns = {}
    for row in csv.reader(io.StringIO(_decode(data))):
        if not row:
            continue
        a = _parse_asn(row[0])
        if a:
            asns[a] = asns.get(a, 0) | tagmask
    return {"ranges": [], "asns": asns}


def parse_bgptools(data, tagmask):
    cls_mask = {k: sum(1 << TAG_BIT[t] for t in v) for k, v in BGP_CLASS_TAGS.items()}
    asns = {}
    n = 0
    for row in csv.reader(io.StringIO(_decode(data))):
        if len(row) < 3:
            continue
        a = _parse_asn(row[0])
        if not a:
            continue
        n += 1
        m = cls_mask.get(row[2].strip().lower(), 0)
        if m:
            asns[a] = asns.get(a, 0) | m
    return {"ranges": [], "asns": asns, "count": n}


PARSERS = {
    "json": parse_json_walk,
    "azure": parse_json_walk,
