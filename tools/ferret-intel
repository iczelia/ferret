}


def parse_feed(name, data):
    _, _, parser, tag, _ = FEED_BY_NAME[name]
    tagmask = (1 << TAG_BIT[tag]) if tag else 0
    pname, _, arg = parser.partition(":")
    res = PARSERS[pname](data, tagmask, arg) if arg else PARSERS[pname](data, tagmask)
    res["entries"] = res.pop("count", len(res["ranges"]) + len(res["asns"]))
    return res


# State / fetching

class Feed:
    def __init__(self, state_dir, name):
        self.name = name
        self.raw_path = os.path.join(state_dir, name + ".raw")
        self.meta_path = os.path.join(state_dir, name + ".meta.json")
        try:
            with open(self.meta_path) as f:
                self.meta = json.load(f)
        except (OSError, ValueError):
            self.meta = {}
        if not self.meta.get("last_success") and os.path.exists(self.raw_path):
            self.meta["last_success"] = int(os.path.getmtime(self.raw_path))

    def save_meta(self):
        atomic_write(self.meta_path, json.dumps(self.meta, indent=1, sort_keys=True).encode())

    def due(self, now, cadence):
        last_ok = self.meta.get("last_success", 0)
        last_try = self.meta.get("last_attempt", 0)
        if now - last_ok + RETRY_SLACK < cadence:
            return False
        # after a failure, retry at most hourly (or at the feed cadence if shorter)
        if self.meta.get("last_error") and now - last_try + RETRY_SLACK < min(cadence, HOUR):
            return False
        return True


def atomic_write(path, data, mode=0o644):
    d = os.path.dirname(os.path.abspath(path))
    fd, tmp = tempfile.mkstemp(prefix="." + os.path.basename(path) + ".", dir=d)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    try:
        dfd = os.open(d, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)
    except OSError:
        pass


def http_get(url, ua, etag=None, last_modified=None):
    """Returns (status, body, headers). status 304 => body None."""
    hdr = {"User-Agent": ua, "Accept-Encoding": "gzip", "Accept": "*/*"}
    if etag:
        hdr["If-None-Match"] = etag
    if last_modified:
        hdr["If-Modified-Since"] = last_modified
    req = urllib.request.Request(url, headers=hdr)
    try:
        resp = urllib.request.urlopen(req, timeout=HTTP_TIMEOUT)   # follows redirects
    except urllib.error.HTTPError as e:
        if e.code == 304:
            return 304, None, e.headers
        raise
    with resp:
        body = resp.read(MAX_BODY + 1)
        if len(body) > MAX_BODY:
            raise ValueError("response too large")
        if (resp.headers.get("Content-Encoding") or "").lower() == "gzip":
            body = gzip.decompress(body)
        return resp.status, body, resp.headers


def fetch_feed(feed, url, parser, ua, now):
    """Download one feed; on success replace the cache. Raises on failure."""
    m = feed.meta
    etag, lm = m.get("etag"), m.get("last_modified")
    if not os.path.exists(feed.raw_path):
        etag = lm = None
    if parser == "azure":
        _, page, _ = http_get(url, ua)
        found = AZURE_JSON_RE.search(page or b"")
        if not found:
            raise ValueError("ServiceTags_Public_*.json link not found on details page")
        real = found.group(0).decode()
        if real == m.get("resolved_url") and os.path.exists(feed.raw_path):
            return "not modified"
        url, etag, lm = real, None, None
    status, body, headers = http_get(url, ua, etag, lm)
    if status == 304:
        return "not modified"
    res = parse_feed(feed.name, body)            # validate before replacing the cache
    if res["entries"] == 0:
        raise ValueError(f"parsed 0 entries from {len(body)} bytes")
    atomic_write(feed.raw_path, body)
    m["etag"] = headers.get("ETag")
    m["last_modified"] = headers.get("Last-Modified")
    if parser == "azure":
        m["resolved_url"] = url
    m["bytes"] = len(body)
    m["entries"] = res["entries"]
    return f"{res['entries']} entries"


# Sweep-line merge

def merge_ranges(ranges):
    """ranges: iterable of (start, end, tags, score), end inclusive.
    Returns sorted non-overlapping [(start, end, tags, score)], with OR of tags and max
    score of all covering ranges; adjacent equal intervals merged; empty dropped."""
    # 1. combine identical (start, end) to shrink the event list
    comb = {}
    for s, e, t, sc in ranges:
        k = (s, e)
        old = comb.get(k)
        if old is None:
            comb[k] = (t, sc)
        else:
            comb[k] = (old[0] | t, sc if sc > old[1] else old[1])
    if not comb:
        return []
    # 2. events: (pos, delta, tags, score); removal at end+1
    events = []
    ap = events.append
    for (s, e), (t, sc) in comb.items():
        if t == 0 and sc == 0:
            continue
        ap((s, 1, t, sc))
        ap((e + 1, -1, t, sc))
    events.sort(key=lambda ev: ev[0])
    bitcount = [0] * 64
    scorecount = [0] * 256
    cur_tags = 0
    cur_score = 0
    out = []
    i, n = 0, len(events)
    while i < n:
        pos = events[i][0]
        while i < n and events[i][0] == pos:
            _, d, t, sc = events[i]
            i += 1
            while t:
                low = t & -t
                b = low.bit_length() - 1
                c = bitcount[b] + d
                bitcount[b] = c
                if d > 0:
                    cur_tags |= low
                elif c == 0:
                    cur_tags &= ~low
                t ^= low
            if sc:
                scorecount[sc] += d
                if d > 0:
                    if sc > cur_score:
                        cur_score = sc
                elif sc == cur_score and scorecount[sc] == 0:
                    while cur_score and scorecount[cur_score] == 0:
                        cur_score -= 1
        if i >= n:
            break
        nxt = events[i][0]
        if cur_tags or cur_score:
            if out and out[-1][1] + 1 == pos and out[-1][2] == cur_tags and out[-1][3] == cur_score:
                out[-1][1] = nxt - 1
            else:
                out.append([pos, nxt - 1, cur_tags, cur_score])
    return [tuple(x) for x in out]


# intel.bin encode / decode

def _align8(n):
    return (n + 7) & ~7


def names_text():
    return "".join(f"{i} {n}\n" for i, n in enumerate(TAGS)).encode()


def encode_intel(v4, v6, asns, feeds_status, build_time):
    t4 = b"".join(V4_ENTRY.pack(s, e, t, sc) for s, e, t, sc in v4)
    t6 = b"".join(V6_ENTRY.pack(s.to_bytes(16, "big"), e.to_bytes(16, "big"), t, sc)
                  for s, e, t, sc in v6)
    ta = b"".join(ASN_ENTRY.pack(a, 0, asns[a]) for a in sorted(asns))
    names = names_text()
    feeds = json.dumps(feeds_status, sort_keys=True, separators=(",", ":")).encode()
    parts = []
    off = HEADER.size
    offs = []
    for blob in (t4, t6, ta, names, feeds):
        off = _align8(off)
        offs.append(off)
        parts.append((off, blob))
        off += len(blob)
    hdr = HEADER.pack(MAGIC, FORMAT_VERSION, build_time, build_time & 0xFFFFFFFF,
                      len(v4), len(v6), len(asns), offs[0], offs[1], offs[2],
                      offs[3], len(names), offs[4], len(feeds), 0)
    buf = bytearray(off)
    buf[0:64] = hdr
    for o, blob in parts:
        buf[o:o + len(blob)] = blob
    return bytes(buf)


def decode_intel(buf):
    h = HEADER.unpack_from(buf, 0)
    (magic, ver, btime, iver, n4, n6, nasn, off4, off6, offasn,
     offn, lenn, offf, lenf, _res) = h
    if magic != MAGIC:
        raise ValueError("bad magic")
    if ver != FORMAT_VERSION:
        raise ValueError(f"unsupported format_version {ver}")
    v4 = [V4_ENTRY.unpack_from(buf, off4 + i * 24) for i in range(n4)]
    v6 = []
    for i in range(n6):
        s, e, t, sc = V6_ENTRY.unpack_from(buf, off6 + i * 48)
        v6.append((int.from_bytes(s, "big"), int.from_bytes(e, "big"), t, sc))
    asns = [ASN_ENTRY.unpack_from(buf, offasn + i * 16) for i in range(nasn)]
    return {
        "build_time": btime, "intel_version": iver,
        "v4": v4, "v6": v6, "asns": [(a, t) for a, _, t in asns],
        "names": buf[offn:offn + lenn].decode(),
        "feeds": json.loads(buf[offf:offf + lenf].decode() or "{}"),
        "_tables": bytes(buf[off4:off4 + n4 * 24]) + bytes(buf[off6:off6 + n6 * 48])
                   + bytes(buf[offasn:offasn + nasn * 16]),
    }


def content_digest(tables_bytes, names, feeds):
    """Digest of everything except timestamps -- decides whether a rebuild is a change."""
    h = hashlib.sha256(tables_bytes)
    h.update(names.encode() if isinstance(names, str) else names)
    norm = {k: {kk: vv for kk, vv in v.items() if kk != "fetched"} for k, v in feeds.items()}
    h.update(json.dumps(norm, sort_keys=True).encode())
    return h.hexdigest()


def tag_names(mask):
    out = []
    for i in range(64):
        if mask >> i & 1:
            out.append(TAGS[i] if i < len(TAGS) else f"bit{i}")
    return ",".join(out) or "-"


def fmt_addr(fam, v):
    if fam == 4:
        return socket.inet_ntop(_AF4, v.to_bytes(4, "big"))
    return socket.inet_ntop(_AF6, v.to_bytes(16, "big"))


def lookup(d, ip):
    import bisect
    r = parse_ip_range(ip)
    if not r or r[1] != r[2]:
        raise ValueError(f"not an IP address: {ip}")
    tab = d["v4"] if r[0] == 4 else d["v6"]
    starts = [x[0] for x in tab]
    i = bisect.bisect_right(starts, r[1]) - 1
    if i >= 0 and tab[i][0] <= r[1] <= tab[i][1]:
        return tab[i]
    return None


# Build

def build(state_dir, now):
    r4, r6, asns, status = [], [], {}, {}
    for name, _url, _parser, _tag, cadence in FEEDS:
        feed = Feed(state_dir, name)
        m = feed.meta
        st = {"ok": False, "fetched": int(m.get("last_success", 0)), "entries": 0,
              "error": m.get("last_error")}
        if not os.path.exists(feed.raw_path):
            st["fetched"] = 0
            st["error"] = st["error"] or "no cached data"
            status[name] = st
            continue
        try:
            with open(feed.raw_path, "rb") as f:
                res = parse_feed(name, f.read())
        except Exception as e:   # noqa: BLE001 -- isolate any parser failure
            st["error"] = f"parse: {type(e).__name__}: {e}"
            status[name] = st
            continue
        st["entries"] = res["entries"]
        st["ok"] = not st["error"]
        limit = max(4 * cadence, 2 * DAY)
        if st["fetched"] and now - st["fetched"] > limit:
            # message must not contain the age, else every run would count as a change
            st["ok"] = False
            st["error"] = (st["error"] + "; " if st["error"] else "") + \
                f"stale: no success for more than {limit // HOUR} h"
        for fam, s, e, t, sc in res["ranges"]:
            (r4 if fam == 4 else r6).append((s, e, t, sc))
        for a, t in res["asns"].items():
            asns[a] = asns.get(a, 0) | t
        status[name] = st
    t0 = time.monotonic()
    v4 = merge_ranges(r4)
    v6 = merge_ranges(r6)
    log(f"merged {len(r4)}+{len(r6)} ranges -> {len(v4)} v4 + {len(v6)} v6 intervals, "
        f"{len(asns)} ASNs in {time.monotonic() - t0:.1f}s")
    return v4, v6, asns, status


def archive(state_dir, data, iver):
    adir = os.path.join(state_dir, "archive")
    os.makedirs(adir, exist_ok=True)
    atomic_write(os.path.join(adir, f"intel-{iver}.bin.xz"), lzma.compress(data, preset=6))


# CLI

def cmd_dump(path):
    with open(path, "rb") as f:
        d = decode_intel(f.read())
    w = sys.stdout.write
    w(f"# build_time {d['build_time']} ({time.strftime('%Y-%m-%d %H:%M:%S', time.gmtime(d['build_time']))} UTC)"
      f" intel_version {d['intel_version']}\n")
    w(f"# v4 {len(d['v4'])}  v6 {len(d['v6'])}  asn {len(d['asns'])}\n")
    w("# feeds\n")
    for k, v in sorted(d["feeds"].items()):
        w(f"feed {k} ok={v['ok']} fetched={v['fetched']} entries={v['entries']} error={v['error']}\n")
    w("# names\n" + d["names"])
    for s, e, t, sc in d["v4"]:
        w(f"v4 {fmt_addr(4, s)} {fmt_addr(4, e)} {tag_names(t)} {sc}\n")
    for s, e, t, sc in d["v6"]:
        w(f"v6 {fmt_addr(6, s)} {fmt_addr(6, e)} {tag_names(t)} {sc}\n")
    for a, t in d["asns"]:
        w(f"asn {a} {tag_names(t)}\n")


def cmd_lookup(args):
    what = args[0]
    path = args[1] if len(args) > 1 else DEFAULT_OUT
    with open(path, "rb") as f:
        d = decode_intel(f.read())
    a = _parse_asn(what) if what.upper().startswith("AS") or what.isdigit() else None
    if a:
        for asn, t in d["asns"]:
            if asn == a:
                print(f"AS{a} tags={tag_names(t)}")
                return 0
        print(f"AS{a} tags=-")
        return 0
    hit = lookup(d, what)
    if hit:
        fam = 4 if ":" not in what else 6
        print(f"{what} range={fmt_addr(fam, hit[0])}-{fmt_addr(fam, hit[1])} "
              f"tags={tag_names(hit[2])} score={hit[3]}")
    else:
        print(f"{what} tags=- score=0")
    return 0


def cmd_list_tags():
    by_tag = {}
    for name, _u, parser, tag, _c in FEEDS:
        if tag:
            by_tag.setdefault(tag, []).append(name)
    for cls, tags in BGP_CLASS_TAGS.items():
        for t in tags:
            by_tag.setdefault(t, []).append(f"bgptools_asns[{cls}]")
    asn_level = {"hosting_asn", "spamhaus_asndrop", "bgp_eyeball", "bgp_content",
                 "bgp_carrier", "bgp_t1"}
    for i, n in enumerate(TAGS):
        lvl = "asn  " if n in asn_level else "range"
        print(f"{i:2d} {n:20s} {lvl} {', '.join(by_tag.get(n, []))}")
    print("   ipsum_score          range ipsum (u8 score, not a bit)")


def main(argv=None):
    ap = argparse.ArgumentParser(
        prog="ferret-intel",
        description="Download threat-intel/classification feeds and build intel.bin "
                    "for the nginx ferret module.")
    ap.add_argument("--state-dir", default=DEFAULT_STATE_DIR,
                    help=f"feed cache directory (default {DEFAULT_STATE_DIR})")
    ap.add_argument("--out", default=DEFAULT_OUT, help=f"output file (default {DEFAULT_OUT})")
    ap.add_argument("--contact", default=os.environ.get("FERRET_CONTACT", DEFAULT_CONTACT),
                    help="HTTP User-Agent incl. contact address, required by bgp.tools "
                         f"(env FERRET_CONTACT; default {DEFAULT_CONTACT!r})")
    ap.add_argument("--offline", action="store_true", help="no network; build from cache only")
    ap.add_argument("--force", action="store_true",
                    help="ignore cadences (fetch all due-or-not) and always rewrite the output")
    ap.add_argument("--only", metavar="FEED,...",
                    help="fetch only these feeds (ignoring their cadence); "
                         "the build still uses every cached feed")
    ap.add_argument("--reload", action="store_true",
                    help="run 'nginx -s reload' after a build whose content changed")
    ap.add_argument("--changed-marker", metavar="PATH",
                    help="touch PATH when the build content changed (for a privileged "
                         "ExecStartPost that reloads nginx)")
    ap.add_argument("--list-tags", action="store_true", help="print tag bits and their sources")
    ap.add_argument("--list-feeds", action="store_true", help="print the feed table")
    ap.add_argument("--dump", metavar="FILE", help="decode an intel.bin to text")
    ap.add_argument("--lookup", nargs="+", metavar=("IP|ASN", "FILE"),
                    help="look up an IP (or ASxxx) in FILE (default --out)")
    a = ap.parse_args(argv)

    if a.list_tags:
        cmd_list_tags()
        return 0
    if a.list_feeds:
        for name, url, parser, tag, cad in FEEDS:
            print(f"{name:26s} {cad // HOUR:4d}h {parser:13s} {tag or '-':20s} {url}")
        return 0
    if a.dump:
        cmd_dump(a.dump)
        return 0
    if a.lookup:
        return cmd_lookup(a.lookup)

    only = None
    if a.only:
        only = {x.strip() for x in a.only.split(",") if x.strip()}
        bad = only - set(FEED_BY_NAME)
        if bad:
            ap.error(f"unknown feed(s): {', '.join(sorted(bad))} (see --list-feeds)")

    os.makedirs(a.state_dir, exist_ok=True)
    lockf = open(os.path.join(a.state_dir, ".lock"), "w")
    try:
        fcntl.flock(lockf, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        log("another instance is running; exiting")
        return 1

    now = int(time.time())
    if not a.offline:
        for name, url, parser, _tag, cadence in FEEDS:
            if only is not None and name not in only:
                continue
            feed = Feed(a.state_dir, name)
            if only is None and not a.force and not feed.due(now, cadence):
                continue
            feed.meta["last_attempt"] = now
            try:
                msg = fetch_feed(feed, url, parser, a.contact, now)
                feed.meta["last_success"] = int(time.time())
                feed.meta["last_error"] = None
                log(f"{name}: {msg}")
            except Exception as e:   # noqa: BLE001 -- per-feed isolation
                err = f"{type(e).__name__}: {e}"[:300]
                feed.meta["last_error"] = err
                log(f"{name}: FAILED ({err}); keeping previous data")
            feed.save_meta()

    v4, v6, asns, status = build(a.state_dir, now)
    data = encode_intel(v4, v6, asns, status, now)
    new = decode_intel(data)
    new_digest = content_digest(new["_tables"], new["names"], new["feeds"])
    old_digest = None
    try:
        with open(a.out, "rb") as f:
            old = decode_intel(f.read())
        old_digest = content_digest(old["_tables"], old["names"], old["feeds"])
    except (OSError, ValueError, struct.error):
        pass
    nfail = sum(1 for s in status.values() if not s["ok"])
    if old_digest == new_digest and not a.force:
        log(f"content unchanged; keeping {a.out} ({nfail} feed(s) not ok)")
        return 0
    os.makedirs(os.path.dirname(os.path.abspath(a.out)), exist_ok=True)
    atomic_write(a.out, data)
    try:
        archive(a.state_dir, data, now & 0xFFFFFFFF)
    except OSError as e:
        log(f"archive failed: {e}")
    log(f"wrote {a.out}: intel_version {now & 0xFFFFFFFF}, {len(v4)} v4, {len(v6)} v6, "
        f"{len(asns)} ASN entries, {len(data)} bytes; {nfail} feed(s) not ok")
    if old_digest != new_digest:
        if a.changed_marker:
            with open(a.changed_marker, "w") as f:
                f.write(f"{now}\n")
        if a.reload:
            r = subprocess.run(["nginx", "-s", "reload"])
            if r.returncode != 0:
                log(f"nginx -s reload failed with exit code {r.returncode}")
                return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
